</g>
<g transform="translate(430,120)">
  <rect x="0" y="-26" width="150" height="52" rx="8" fill="#244" stroke="#C9A961"/><text x="75" y="6" fill="#F5EFE0" font-size="13" text-anchor="middle">飼料大分子蛋白</text>
